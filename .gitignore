.moves-sheets/

sound-lab.html
components/lesson/cinematic/.measure-must.lock

# superpowers brainstorming companion (mockups, not source)
.superpowers/

# harness route locks (scripts/lib/previewroute.mjs)
scripts/.preview-*.lock
# sheet-pass.mjs writes its screenshots here to be looked at, not kept
scripts/.pass-shots/
