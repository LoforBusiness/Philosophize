{
  "expo": {
    "name": "Philosophize",
    "slug": "Philosophize",
    "owner": "lobusiness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "philosophize",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/944e9d06-b89c-42c3-999a-0c35ac84ac1b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.philosophize.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.philosophize.app",
      "adaptiveIcon": {
        "backgroundColor": "#f5f4f0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "resizeMode": "contain",
          "backgroundColor": "#E4E4DF"
        }
      ],
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8916255747221090~2303226096",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This lets us show ads relevant to you and keep Philosophize free. You can decline and still use the app."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuoteOfTheDay",
              "label": "Philosophize — Quote",
              "description": "A philosophy quote that changes through the day.",
              "previewImage": "./assets/images/widget-preview.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "360dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 10800000
            }
          ]
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1A1A1A"
        }
      ],
      "expo-quick-actions",
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "944e9d06-b89c-42c3-999a-0c35ac84ac1b"
      }
    }
  }
}
