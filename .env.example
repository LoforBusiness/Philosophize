# Copy this file to .env.local (gitignored) and fill in real values.
# All keys are exposed to client code, so the EXPO_PUBLIC_ prefix is required.

# Supabase (auth + cloud sync) — Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog (product analytics) — Project Settings
EXPO_PUBLIC_POSTHOG_KEY=phc_your_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat (subscriptions) — Project → API keys → "App-specific" PUBLIC SDK keys
# (iOS starts with "appl_", Android with "goog_"). These only work in a native
# build (dev client / TestFlight / store), not Expo Go or web. See
# docs/REVENUECAT_SETUP.md.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_sdk_key

# Google Sign-In (social login). The Web client id is also registered in the
# Supabase Google provider; the iOS client id matches the app.json plugin's
# iosUrlScheme. Native dev/standalone build only — no effect on web/Expo Go.
# See docs/AUTH_SOCIAL_SETUP.md. (Apple Sign-In needs no env var — it's wired via
# app.json ios.usesAppleSignIn + the Supabase Apple provider.)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-yyyyyyyy.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-zzzzzzzz.apps.googleusercontent.com

# Google AdMob (interstitial after each lesson for free users; Pro sees none).
# The AdMob *App IDs* live in app.json (the config plugin), not here. These are
# the INTERSTITIAL ad *unit* ids. In development the app auto-uses Google's test
# unit, so these only matter for production builds. See docs/ADMOB_SETUP.md.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# Reviewer / tester allow-list (comma-separated emails). Accounts listed here get
# Scholar's Pass with no purchase, so store reviewers can clear the paywall.
# Deliberately NOT hardcoded — this repo is public. Unset = nobody is a reviewer,
# which is the correct default for a public release.
EXPO_PUBLIC_REVIEWER_EMAILS=reviewer@example.com
